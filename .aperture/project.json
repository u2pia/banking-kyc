{
  "schemaVersion": "aperture.project.v1",
  "productType": "application",
  "context": {
    "required": [
      "README.md",
      "package.json",
      "src/kyc.ts",
      "test/kyc.test.ts"
    ],
    "allowed": [
      "README.md",
      "package.json",
      "src/kyc.ts",
      "test/kyc.test.ts"
    ]
  },
  "checks": [
    {
      "name": "node-tests",
      "command": ["npm", "test"],
      "timeoutMs": 300000
    },
    {
      "name": "application-build",
      "kind": "build",
      "command": ["npm", "run", "build"],
      "timeoutMs": 120000
    }
  ],
  "artifact": {
    "profile": "application_build",
    "buildCheck": "application-build",
    "outputs": ["dist/kyc.js", "dist/bankAiCases.js"]
  },
  "testPaths": ["test"],
  "policy": {
    "maximumRisk": "high",
    "allowUnisolatedRuntime": true
  }
}
